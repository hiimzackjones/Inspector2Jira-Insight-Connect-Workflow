  {
   "nodeId": "b3e76992-72c0-4baa-b14e-5479d377f284",
   "name": "ExtractHostsFromExistingTicket",
   "description": "",
   "type": "action",
   "metadata": {
    "parameters": {
     "input": {
      "flags": [],
      "filter": "def safe_hosts(x):\n  (x.description // \"\") as $d\n  | if ($d|type)==\"string\" and ($d|contains(\"[AFFECTED-HOSTS]\"))\n    then ($d | split(\"[AFFECTED-HOSTS]\")[1] | split(\"[/AFFECTED-HOSTS]\")[0] | gsub(\"\\\\\\\\n\"; \" \") | gsub(\"^\\\\s+|\\\\s+$\"; \"\"))\n    else empty\n    end;\n[.issues[] | safe_hosts(.)] | join(\", \")",
      "json_in": {
       "issues": "{{[2d52777d-4cc8-4468-af9d-e49e97ff32e6].[enriched_issues]}}"
      },
      "timeout": 15
     }
    },
    "identifier": "run_jq",
    "continueOnFailure": false,
    "isDisabled": false,
    "plugin": {
     "name": "jq",
     "vendor": "rapid7",
     "version": "3.0.0"
    },
