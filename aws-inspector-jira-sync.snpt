{
 "name": "AWS Inspector to Jira Ticket Sync",
 "summary": "Syncs AWS Inspector findings (via Rapid7 Surface Command) to Jira tickets. For each finding: creates a ticket if none exists, adds a new ticket scoped to newly-affected hosts if the existing ticket's host list has grown, edits the existing ticket down and comments if hosts have been remediated, and closes tickets automatically if a finding disappears from the query entirely. No script steps - every transformation uses the jq plugin or native InsightConnect steps, so it can be modified without custom code.",
 "tags": [],
 "inputSchema": {
  "type": "object",
  "properties": {
   "ProjectID": {
    "type": "string",
    "default": "10000",
    "description": "Your Jira project's numeric ID (find it in the project's URL or via the Jira API)"
   },
   "ProjectIDKey": {
    "type": "string",
    "default": "PROJ",
    "description": "Your Jira project's key, used when creating new tickets"
   },
   "CompletedIssueStatus": {
    "type": "string",
    "default": "Done",
    "description": "The Jira status name used to exclude closed tickets from searches and as the closing transition target"
   }
  },
  "definitions": {}
 },
 "outputSchema": {
  "type": "object",
  "properties": {},
  "definitions": {}
 },
 "outputValues": {},
 "notes": "",
 "steps": [
